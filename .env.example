# vLLM (OpenAI-compatible API served by vLLM on the ThinkStation)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=openai/gpt-oss-120b
VLLM_API_KEY=not-needed-for-local

# OpenCode binary (defaults to "opencode" on PATH)
OPENCODE_BIN=opencode
# Provider/model id as it appears in your opencode config (e.g. "vllm/gpt-oss-120b")
OPENCODE_MODEL=vllm/gpt-oss-120b
# Per-generation hard timeout in ms (each stage call gets this much)
OPENCODE_TIMEOUT_MS=900000

# Quality vs. speed: 1 = implement only (~2 min), 2 = +critique (~5 min), 3 = +polish (~7-10 min)
REFINE_STAGES=3
# Per-stage retry budget when validation fails
STAGE_MAX_ATTEMPTS=3

# Public games repo (manager pushes here; GitHub Pages serves it)
GAMES_REPO_PATH=/home/matt/Repos/slop-factory-site
GAMES_REPO_REMOTE=https://github.com/YOUR-USER/slop-factory-site.git
GAMES_PAGES_BASE_URL=https://YOUR-USER.github.io/slop-factory-site
GITHUB_TOKEN=github_pat_replace_me

# Discord webhook (Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Sandbox root for per-game work dirs
SANDBOX_ROOT=/tmp/slop-factory-work

# Loop cadence
LOOP_COOLDOWN_MS=1800000
